{
  "name": "homeschool-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:live": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "live:start": "powershell -ExecutionPolicy Bypass -File scripts/start-live-ngrok.ps1",
    "build": "tsc -b && vite build",
    "audit:games": "node ./scripts/audit-games.mjs",
    "assets:glb:audit": "node ./scripts/optimize-glb-assets.mjs --check",
    "assets:glb:optimize": "node ./scripts/optimize-glb-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@gltf-transform/cli": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
