{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeschool.local/schema/experience-manifest.schema.json",
  "title": "Homeschool Experience Manifest",
  "oneOf": [
    { "$ref": "#/$defs/gameManifest" },
    { "$ref": "#/$defs/classroomManifest" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "entry": {
      "type": "string",
      "pattern": "^\\./(?!.*\\.\\.)(?!.*\\\\).+$"
    },
    "runtime": {
      "enum": ["dom", "canvas", "phaser", "three", "react-three-fiber", "legacy-iframe"]
    },
    "roomRuntime": {
      "enum": ["dom", "canvas", "three", "react-three-fiber", "legacy-iframe"]
    },
    "capability": {
      "enum": ["audio", "storage", "rewards", "speech", "camera", "microphone", "fullscreen", "orientation", "network"]
    },
    "permission": {
      "enum": ["camera", "microphone", "geolocation", "accelerometer", "gyroscope"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyPaths", "protocolVersion"],
      "properties": {
        "legacyPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/(?!.*\\.\\.)(?!.*\\\\).+$"
          }
        },
        "protocolVersion": { "const": 1 }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "points"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "points": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000,
          "not": { "const": 0 }
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "targetId", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["catalog", "module"] },
        "targetId": { "$ref": "#/$defs/id" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetRoomId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetRoomId": { "$ref": "#/$defs/id" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry", "runtime", "stations", "portals"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entry": { "$ref": "#/$defs/entry" },
        "runtime": { "$ref": "#/$defs/roomRuntime" },
        "stations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "portals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portal" }
        }
      }
    },
    "gameManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "title",
        "version",
        "entry",
        "runtime",
        "orientation",
        "responsive",
        "classification",
        "capabilities",
        "permissions",
        "mediaBundles",
        "rewards",
        "compatibility"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "game" },
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "entry": { "$ref": "#/$defs/entry" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "orientation": { "enum": ["any", "portrait", "landscape"] },
        "responsive": { "type": "boolean" },
        "classification": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        },
        "mediaBundles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "rewards": {
          "type": "array",
          "items": { "$ref": "#/$defs/reward" }
        },
        "compatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "classroomManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "title",
        "version",
        "orientation",
        "responsive",
        "classification",
        "permissions",
        "mediaBundles",
        "compatibility",
        "entryRoomId",
        "rooms",
        "stations"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "classroom" },
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "orientation": { "enum": ["any", "portrait", "landscape"] },
        "responsive": { "type": "boolean" },
        "classification": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        },
        "mediaBundles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "entryRoomId": { "$ref": "#/$defs/id" },
        "rooms": {
          "type": "array",
          "items": { "$ref": "#/$defs/room" }
        },
        "stations": {
          "type": "array",
          "items": { "$ref": "#/$defs/station" }
        }
      }
    }
  }
}
